# nginx site for the private preview. Copy to /etc/nginx/sites-available/<subdomain>, replace
# SUBDOMAIN.erptek.net, symlink into sites-enabled, then `sudo nginx -t && sudo systemctl reload nginx`.
# Step-by-step: docs/deploy.md.

server {
    listen 80;
    listen [::]:80;
    server_name SUBDOMAIN.erptek.net;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name SUBDOMAIN.erptek.net;

    ssl_certificate     /etc/letsencrypt/live/SUBDOMAIN.erptek.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/SUBDOMAIN.erptek.net/privkey.pem;

    root /var/www/thienlong/current;
    index index.html;

    # Friends only: a shared password, and no search engines.
    auth_basic           "Thien Long - friends only";
    auth_basic_user_file /etc/nginx/thienlong.htpasswd;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Built assets carry a content hash in their name: cache them for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        try_files $uri =404;
    }

    # The page itself must always be fresh so a new release shows at once.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        try_files $uri $uri/ /index.html;
    }

    location = /robots.txt {
        auth_basic off;
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }
}
